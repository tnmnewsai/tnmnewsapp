DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialvideotool"
AUTH_SECRET="change-me-with-openssl-rand-base64-32"
REDIS_URL="redis://localhost:6379"

# Local dev needs nothing here — inngest.send() talks to the local Inngest
# Dev Server automatically. Production: set INNGEST_EVENT_KEY from the same
# Inngest Cloud project apps/worker connects to (Settings > Event Keys).
# INNGEST_EVENT_KEY=""

# Must match apps/worker's STORAGE_* values — both processes share one storage tree.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="C:/socialvideotool/.data/storage"

# Platform publishing (Milestone 8) — base URL for OAuth redirect URIs.
APP_BASE_URL="http://localhost:3000"

# Must match apps/worker's TOKEN_ENCRYPTION_KEY exactly. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""

# YouTube OAuth (Milestone 8) — Google Cloud project with the YouTube Data
# API v3 enabled, OAuth consent screen configured (add yourself as a test
# user), OAuth client redirect URI: http://localhost:3000/api/platforms/youtube/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Meta OAuth (Milestone 9) — Meta Business app with the Instagram Graph API
# product, instagram_content_publish access requested, OAuth redirect URI:
# http://localhost:3000/api/platforms/meta/callback
META_APP_ID=""
META_APP_SECRET=""

# TikTok OAuth (Milestone 10) — TikTok developer app with Login Kit and the
# Content Posting API, OAuth redirect URI:
# http://localhost:3000/api/platforms/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# X OAuth 2.0 (Milestone 11) — X developer app (OAuth 2.0, confidential
# client), redirect URI: http://localhost:3000/api/platforms/x/callback.
# Video media upload requires the paid Basic API tier or above.
X_CLIENT_ID=""
X_CLIENT_SECRET=""
