DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialvideotool"
REDIS_URL="redis://localhost:6379"

# Inngest hosting — the worker uses connect() (outbound-only), so it never
# needs a public URL or inbound port. Local dev: set INNGEST_DEV=1 to talk to
# the local Inngest Dev Server. Production: leave INNGEST_DEV unset and
# instead set INNGEST_SIGNING_KEY / INNGEST_EVENT_KEY from your Inngest Cloud
# dashboard (Settings > Signing Key / Event Keys).
INNGEST_DEV="1"
# INNGEST_SIGNING_KEY=""
# INNGEST_EVENT_KEY=""

# OPENAI_API_KEY / ANTHROPIC_API_KEY are no longer read at runtime — every
# account configures its own key on the Platforms page (AiProviderCredential),
# with no shared env-var fallback, so one account's usage/billing never leaks
# onto another's. These are left unset intentionally; do not repurpose them
# as a global default.

# Private Google Drive access — lets "Google Drive link" sources pull files
# that are only shared with a dedicated service account, not just public
# links. Base64-encode the full service account JSON key file:
#   (Get-Content key.json -Raw) | ... -> [Convert]::ToBase64String(...)  (PowerShell)
#   base64 -w0 key.json   (bash)
# then share the Drive file/folder with the service account's client_email
# (Viewer access is enough). Leave unset to keep using public-link-only access.
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=""

# Must match apps/dashboard's TOKEN_ENCRYPTION_KEY exactly.
TOKEN_ENCRYPTION_KEY=""

# YouTube OAuth (Milestone 8) — same Google Cloud OAuth client as apps/dashboard.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Meta OAuth (Milestone 9) — same Meta app as apps/dashboard.
META_APP_ID=""
META_APP_SECRET=""

# TikTok OAuth (Milestone 10) — same TikTok app as apps/dashboard.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# X OAuth 2.0 (Milestone 11) — same X app as apps/dashboard.
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Storage — "local" (default) needs no config beyond STORAGE_LOCAL_ROOT;
# switch to "s3" and set the S3_* vars to use R2/AWS S3 instead.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="C:/Users/17205/Desktop/socialvideotool/.data/storage"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
