DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialvideotool"
# Only consulted by Prisma migrations/introspection, never by the running app.
# Locally this can match DATABASE_URL. For Neon, DATABASE_URL should use the
# pooled connection string and DIRECT_URL should use the direct connection.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/socialvideotool"
