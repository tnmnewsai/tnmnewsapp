DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialvideotool"
# Only consulted by `prisma migrate`/introspection, never by the running app.
# Locally the same as DATABASE_URL; in production point it at Supabase's
# direct (unpooled, port 5432) connection string while DATABASE_URL uses the
# transaction-mode pooler (port 6543, with ?pgbouncer=true appended).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/socialvideotool"
